<resources>
    <style name="Theme.R1999TrackerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="appBgPage">@color/warm_bg_page</item>
        <item name="appBgSurface">@color/warm_bg_surface</item>
        <item name="appStroke">@color/warm_stroke</item>
        <item name="appTextPrimary">@color/warm_text_primary</item>
        <item name="appTextMuted">@color/warm_text_muted</item>
        <item name="appAccent">@color/warm_accent</item>
        <item name="appLog">@color/warm_log</item>
        <item name="appLogBg">@color/warm_log_bg</item>
        <item name="appNavChecked">@color/warm_accent</item>
        <item name="appNavBg">@color/warm_nav_bg</item>
        <item name="colorPrimary">@color/warm_accent</item>
        <item name="colorOnPrimary">#1A1109</item>
        <item name="android:windowBackground">?attr/appBgPage</item>
        <item name="android:statusBarColor">?attr/appBgPage</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="materialAlertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="shapeAppearanceCornerExtraLarge">@style/AppDialog.Shape</item>
        <item name="colorSurface">?attr/appBgSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/appBgSurface</item>
        <item name="colorOnSurface">?attr/appTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/appTextMuted</item>
        <item name="android:textColorPrimary">?attr/appTextPrimary</item>
        <item name="android:textColorSecondary">?attr/appTextMuted</item>
        <item name="android:textColorAlertDialogListItem">?attr/appTextPrimary</item>
        <item name="colorPrimary">?attr/appAccent</item>
        <item name="colorAccent">?attr/appAccent</item>
        <item name="android:colorAccent">?attr/appAccent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AppDialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialog.Button.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialog.Button.Muted</item>
    </style>

    <style name="AppDialog.Classic">
        <item name="materialAlertDialogTitleTextStyle">@style/AppDialog.Title.Classic</item>
    </style>

    <style name="AppDialog.Title.Classic">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppDialog.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="AppDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/appAccent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppDialog.Button.Muted">
        <item name="android:textColor">?attr/appTextMuted</item>
    </style>

    <style name="Theme.R1999TrackerApp.Classic">
        <item name="appBgPage">@color/cool_bg_page</item>
        <item name="appBgSurface">@color/cool_bg_surface</item>
        <item name="appStroke">@color/cool_stroke</item>
        <item name="appTextPrimary">@color/cool_text_primary</item>
        <item name="appTextMuted">@color/cool_text_muted</item>
        <item name="appAccent">@color/cool_accent</item>
        <item name="appLog">@color/cool_log</item>
        <item name="appLogBg">@color/cool_log_bg</item>
        <item name="appNavChecked">@color/cool_nav_checked</item>
        <item name="appNavBg">@color/cool_nav_bg</item>
        <item name="colorPrimary">@color/cool_accent</item>
        <item name="colorOnPrimary">#0B0E24</item>
        <item name="alertDialogTheme">@style/AppDialog.Classic</item>
        <item name="materialAlertDialogTheme">@style/AppDialog.Classic</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="CircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
